# Copy to .env and fill in only the providers you use. SportsBench reads these
# automatically. You pay your own providers — SportsBench itself is free.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=

# Ollama / LM Studio run locally and need no key.

# Free fixtures/results (no odds): https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY=

# Optional — SportsBench Pro (managed live data, hosted runs, cloud publish):
# https://modelfights.com/sportsbench
SPORTSBENCH_API_KEY=
